<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="GitVersion.Tool" Version="[6.8.2]" />
    <PackageDownload Include="Mapster.Tool" Version="[10.1.0-pre02]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\GitVersion.yml">
      <Link>config\GitVersion.yml</Link>
    </Content>
  </ItemGroup>
</Project>
